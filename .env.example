# URL de base utilisée par le front pour appeler l'API.
# En dev, laisser /api : Vite redirige vers VITE_API_PROXY_TARGET (pas de souci de CORS).
# En prod, mettre l'URL complète de l'API (ex : https://api.pulse.fr).
VITE_API_URL=/api

# Adresse de l'API en local (utilisée uniquement par le proxy de Vite en dev).
VITE_API_PROXY_TARGET=http://localhost:8080
